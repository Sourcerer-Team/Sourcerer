      QAbstractItemView {
        background-color: palette(window);
        color: palette(window-text);
        alternate-background-color: palette(window);
        selection-background-color: #E7EEF4;
        selection-color: #202020;
        gridline-color: #D0D7DE;
        outline: 0;
      }
      QCheckBox {
        color: palette(window-text);
        spacing: 6px;
      }
      QCheckBox::indicator {
        width: 13px;
        height: 13px;
        border: 1px solid palette(button-text);
        border-radius: 3px;
        background-color: transparent;
      }
      QCheckBox::indicator:checked {
        border: 1px solid #0078d7;
        background-color: transparent;
        image: url(:/icons/checkbox-check-light.svg);
      }
      QCheckBox::indicator:disabled {
        border: 1px solid palette(mid);
        background-color: palette(button);
      }
      QListView, QTreeView, QTableView {
        background-color: palette(window);
        color: palette(window-text);
      }
      QTreeView::branch {
        background: palette(window);
      }
      QTreeView::branch:closed:has-children {
        image: url(:/icons/tree_branch_closed.svg);
        width: 12px;
        height: 12px;
      }
      QTreeView::branch:open:has-children {
        image: url(:/icons/tree_branch_open.svg);
        width: 12px;
        height: 12px;
      }
      QTableView#tableViewRecent,
      QTableView#tableViewWorkspaces,
      QTableView#tableViewIssueTrackerConnections {
        color: palette(window-text);
        background-color: palette(window);
        alternate-background-color: palette(window);
      }
      QListView::item, QTreeView::item, QTableView::item {
        padding: 2px 4px;
      }
      QListView::item:selected,
      QTreeView::item:selected,
      QTableView::item:selected {
        background-color: #E7EEF4;
        color: #202020;
      }
      QHeaderView::section {
        background-color: palette(window);
        color: palette(window-text);
        border: 1px solid #B8C0C8;
        padding: 3px 5px;
      }
      QCheckBox {
        color: palette(window-text);
        spacing: 6px;
      }
      QCheckBox::indicator {
        width: 13px;
        height: 13px;
        border: 1px solid palette(button-text);
        border-radius: 3px;
        background-color: transparent;
      }
      QCheckBox::indicator:checked {
        border: 1px solid palette(highlight);
        background-color: transparent;
        image: url(:/icons/checkbox-check-light.svg);
      }
      QCheckBox::indicator:disabled {
        border: 1px solid palette(mid);
        background-color: palette(button);
      }

      QPushButton[flat=true]{
        color:#202020;
        text-decoration:none;
      }
      QPushButton[flat=true]:hover{
        color:#2A82DA;
