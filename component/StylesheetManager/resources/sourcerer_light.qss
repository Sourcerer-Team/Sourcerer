      }
      GuiManager--Widgets--TitleBarButton#titleBarCloseButton:hover {
        background-color: #E53935;
      }
      GuiManager--Widgets--TitlebarWidget,GuiManager--Widgets--TitlebarWidget * {
        font-size:14px;
