cmake_policy(SET CMP0007 NEW)

if(NOT DEFINED SQLITE3_VDBE_C)
  message(FATAL_ERROR "SQLITE3_VDBE_C is required")
endif()

if(NOT DEFINED SQLITE3_OUTPUT_FILE)
  message(FATAL_ERROR "SQLITE3_OUTPUT_FILE is required")
endif()

set(SQLITE3_PARSE_H "${CMAKE_CURRENT_LIST_DIR}/../src/parse.h")
if(NOT EXISTS "${SQLITE3_PARSE_H}")
  message(FATAL_ERROR "parse.h is required")
endif()

file(READ "${SQLITE3_PARSE_H}" SQLITE3_PARSE_CONTENT)
string(REPLACE "\r" "" SQLITE3_PARSE_CONTENT "${SQLITE3_PARSE_CONTENT}")
string(REPLACE "\n" ";" SQLITE3_PARSE_LINES "${SQLITE3_PARSE_CONTENT}")

file(READ "${SQLITE3_VDBE_C}" SQLITE3_VDBE_CONTENT)
string(REPLACE "\r" "" SQLITE3_VDBE_CONTENT "${SQLITE3_VDBE_CONTENT}")
string(REPLACE "\n" ";" SQLITE3_VDBE_LINES "${SQLITE3_VDBE_CONTENT}")

set(SQLITE3_TK_NAMES)
set(SQLITE3_TK_VALUES)
foreach(_line IN LISTS SQLITE3_PARSE_LINES)
  if(_line MATCHES "^#define[ \t]+TK_([A-Za-z0-9_]+)[ \t]+([0-9]+)$")
    list(APPEND SQLITE3_TK_NAMES "${CMAKE_MATCH_1}")
    list(APPEND SQLITE3_TK_VALUES "${CMAKE_MATCH_2}")
  endif()
endforeach()

function(sqlite3_find_tk_value tk_name result_var)
  set(_value "")
  list(LENGTH SQLITE3_TK_NAMES _count)
  math(EXPR _last "${_count} - 1")
  foreach(_i RANGE 0 ${_last})
    list(GET SQLITE3_TK_NAMES ${_i} _name)
    if(_name STREQUAL "${tk_name}")
      list(GET SQLITE3_TK_VALUES ${_i} _value)
      break()
    endif()
  endforeach()
  set(${result_var} "${_value}" PARENT_SCOPE)
endfunction()

set(SQLITE3_OPCODE_NAMES)
set(SQLITE3_OPCODE_COMMENTS)
set(SQLITE3_OPCODE_FLAGS_RAW)

foreach(_line IN LISTS SQLITE3_VDBE_LINES)
  if(_line MATCHES "^[ \t]*case[ \t]+OP_([A-Za-z0-9_]+):")
    set(_opcode_name "OP_${CMAKE_MATCH_1}")
    list(FIND SQLITE3_OPCODE_NAMES "${_opcode_name}" _existing)
    if(NOT _existing EQUAL -1)
      continue()
    endif()

    set(_comment "")
    string(FIND "${_line}" "/*" _comment_start)
    if(NOT _comment_start EQUAL -1)
      math(EXPR _comment_start "${_comment_start} + 2")
      string(FIND "${_line}" "*/" _comment_end)
      if(NOT _comment_end EQUAL -1 AND _comment_end GREATER _comment_start)
        math(EXPR _comment_len "${_comment_end} - ${_comment_start}")
        string(SUBSTRING "${_line}" ${_comment_start} ${_comment_len} _comment)
        string(STRIP "${_comment}" _comment)
      endif()
    endif()

    list(APPEND SQLITE3_OPCODE_NAMES "${_opcode_name}")
    list(APPEND SQLITE3_OPCODE_COMMENTS "${_comment}")
  endif()
endforeach()

list(LENGTH SQLITE3_OPCODE_NAMES SQLITE3_OPCODE_COUNT)
if(SQLITE3_OPCODE_COUNT EQUAL 0)
  message(FATAL_ERROR "No SQLite opcodes were discovered")
endif()

function(sqlite3_value_is_blocked value result_var)
  set(_found 0)
  foreach(_used IN LISTS SQLITE3_USED_VALUES)
    if(_used STREQUAL "${value}")
      set(_found 1)
      break()
    endif()
  endforeach()
  if(NOT _found)
    foreach(_reserved IN LISTS SQLITE3_RESERVED_VALUES)
      if(_reserved STREQUAL "${value}")
        set(_found 1)
        break()
      endif()
    endforeach()
  endif()
  set(${result_var} ${_found} PARENT_SCOPE)
endfunction()

function(sqlite3_find_opcode value name_var flags_var)
  set(_name "OP_NotUsed_${value}")
  set(_flags 0)
  list(LENGTH SQLITE3_OPCODE_VALUES _count)
  math(EXPR _last "${_count} - 1")
  if(_last GREATER_EQUAL 0)
    foreach(_i RANGE 0 ${_last})
      list(GET SQLITE3_OPCODE_VALUES ${_i} _v)
      if(_v STREQUAL "${value}")
        list(GET SQLITE3_OPCODE_NAMES ${_i} _name)
        list(GET SQLITE3_OPCODE_FLAGS ${_i} _flags)
        break()
      endif()
    endforeach()
  endif()
  set(${name_var} "${_name}" PARENT_SCOPE)
  set(${flags_var} "${_flags}" PARENT_SCOPE)
endfunction()

set(SQLITE3_RESERVED_VALUES)
math(EXPR _opcode_last "${SQLITE3_OPCODE_COUNT} - 1")
foreach(_i RANGE 0 ${_opcode_last})
  list(GET SQLITE3_OPCODE_COMMENTS ${_i} _comment)
  if(_comment MATCHES "same[ \t]+as[ \t]+TK_([A-Za-z0-9_]+)")
    sqlite3_find_tk_value("${CMAKE_MATCH_1}" _value)
    if(_value STREQUAL "")
      message(FATAL_ERROR "Unknown SQLite token TK_${CMAKE_MATCH_1}")
    endif()
    list(FIND SQLITE3_RESERVED_VALUES "${_value}" _reserved_existing)
    if(_reserved_existing EQUAL -1)
      list(APPEND SQLITE3_RESERVED_VALUES "${_value}")
    endif()
  endif()
endforeach()

set(SQLITE3_OPCODE_VALUES)
set(SQLITE3_OPCODE_FLAGS)
set(SQLITE3_USED_VALUES)

foreach(_i RANGE 0 ${_opcode_last})
  list(GET SQLITE3_OPCODE_NAMES ${_i} _opcode_name)
  list(GET SQLITE3_OPCODE_COMMENTS ${_i} _comment)

  set(_value "")
  if(_comment MATCHES "same[ \t]+as[ \t]+TK_([A-Za-z0-9_]+)")
    sqlite3_find_tk_value("${CMAKE_MATCH_1}" _value)
    if(_value STREQUAL "")
      message(FATAL_ERROR "Unknown SQLite token TK_${CMAKE_MATCH_1} for opcode ${_opcode_name}")
    endif()
  endif()

  if(_value STREQUAL "")
    set(_value 0)
    while(1)
      sqlite3_value_is_blocked(${_value} _blocked)
      if(NOT _blocked)
        break()
      endif()
      math(EXPR _value "${_value} + 1")
    endwhile()
  endif()

  list(APPEND SQLITE3_OPCODE_VALUES "${_value}")
  list(APPEND SQLITE3_USED_VALUES "${_value}")

  set(_flags 0)
  if(_comment MATCHES "(^|[^A-Za-z0-9_])jump0([^A-Za-z0-9_]|$)")
    math(EXPR _flags "${_flags} | 0x80")
    math(EXPR _flags "${_flags} | 0x01")
  elseif(_comment MATCHES "(^|[^A-Za-z0-9_])jump([^A-Za-z0-9_]|$)")
    math(EXPR _flags "${_flags} | 0x01")
  endif()
  if(_comment MATCHES "(^|[^A-Za-z0-9_])in1([^A-Za-z0-9_]|$)")
    math(EXPR _flags "${_flags} | 0x02")
  endif()
  if(_comment MATCHES "(^|[^A-Za-z0-9_])in2([^A-Za-z0-9_]|$)")
    math(EXPR _flags "${_flags} | 0x04")
  endif()
  if(_comment MATCHES "(^|[^A-Za-z0-9_])in3([^A-Za-z0-9_]|$)")
    math(EXPR _flags "${_flags} | 0x08")
  endif()
  if(_comment MATCHES "(^|[^A-Za-z0-9_])out2([^A-Za-z0-9_]|$)")
    math(EXPR _flags "${_flags} | 0x10")
  endif()
  if(_comment MATCHES "(^|[^A-Za-z0-9_])out3([^A-Za-z0-9_]|$)")
    math(EXPR _flags "${_flags} | 0x20")
  endif()
  if(_comment MATCHES "(^|[^A-Za-z0-9_])ncycle([^A-Za-z0-9_]|$)")
    math(EXPR _flags "${_flags} | 0x40")
  endif()
  list(APPEND SQLITE3_OPCODE_FLAGS "${_flags}")
endforeach()

set(SQLITE3_MAX_OPCODE -1)
foreach(_value IN LISTS SQLITE3_OPCODE_VALUES)
  if(_value GREATER SQLITE3_MAX_OPCODE)
    set(SQLITE3_MAX_OPCODE ${_value})
  endif()
endforeach()

# Add the synthetic Noop and Explain opcodes that share the default VDBE
# dispatch path. These opcodes do not have explicit case labels in vdbe.c,
# but the generated header and opcode-property table still need them.
math(EXPR _noop_value "${SQLITE3_MAX_OPCODE} + 1")
math(EXPR _explain_value "${SQLITE3_MAX_OPCODE} + 2")
list(APPEND SQLITE3_OPCODE_NAMES OP_Noop OP_Explain)
list(APPEND SQLITE3_OPCODE_COMMENTS "" "")
list(APPEND SQLITE3_OPCODE_VALUES ${_noop_value} ${_explain_value})
list(APPEND SQLITE3_OPCODE_FLAGS 0 0)
set(SQLITE3_MAX_OPCODE ${_explain_value})

file(WRITE "${SQLITE3_OUTPUT_FILE}" "/* Automatically generated. Do not edit. */\n")
file(APPEND "${SQLITE3_OUTPUT_FILE}" "/* Generated without Tcl using CMake. */\n\n")

list(LENGTH SQLITE3_OPCODE_VALUES _opcode_count)
math(EXPR _last_index "${_opcode_count} - 1")
foreach(_i RANGE 0 ${_last_index})
  list(GET SQLITE3_OPCODE_NAMES ${_i} _name)
  list(GET SQLITE3_OPCODE_VALUES ${_i} _value)
  file(APPEND "${SQLITE3_OUTPUT_FILE}" "#define ${_name} ${_value}\n")
endforeach()

file(APPEND "${SQLITE3_OUTPUT_FILE}" "\n")
file(APPEND "${SQLITE3_OUTPUT_FILE}" "#define OPFLG_JUMP        0x01\n")
file(APPEND "${SQLITE3_OUTPUT_FILE}" "#define OPFLG_IN1         0x02\n")
file(APPEND "${SQLITE3_OUTPUT_FILE}" "#define OPFLG_IN2         0x04\n")
file(APPEND "${SQLITE3_OUTPUT_FILE}" "#define OPFLG_IN3         0x08\n")
file(APPEND "${SQLITE3_OUTPUT_FILE}" "#define OPFLG_OUT2        0x10\n")
file(APPEND "${SQLITE3_OUTPUT_FILE}" "#define OPFLG_OUT3        0x20\n")
file(APPEND "${SQLITE3_OUTPUT_FILE}" "#define OPFLG_NCYCLE      0x40\n")
file(APPEND "${SQLITE3_OUTPUT_FILE}" "#define OPFLG_JUMP0       0x80\n\n")
file(APPEND "${SQLITE3_OUTPUT_FILE}" "#define OPFLG_INITIALIZER {\\\n")
foreach(_value RANGE 0 ${SQLITE3_MAX_OPCODE})
  sqlite3_find_opcode(${_value} _name _flags)
  math(EXPR _mod "${_value} % 8")
  if(_mod EQUAL 0)
    file(APPEND "${SQLITE3_OUTPUT_FILE}" "/* ${_value} */")
  endif()
  file(APPEND "${SQLITE3_OUTPUT_FILE}" " ${_flags},")
  if(_mod EQUAL 7)
    file(APPEND "${SQLITE3_OUTPUT_FILE}" "\\\n")
  endif()
endforeach()

file(APPEND "${SQLITE3_OUTPUT_FILE}" "}\n\n")
file(APPEND "${SQLITE3_OUTPUT_FILE}" "#define SQLITE_MX_JUMP_OPCODE ${SQLITE3_MAX_OPCODE}\n")
