if(NOT DEFINED APR_ESCAPE_TEST_CHAR_H)
  message(FATAL_ERROR "APR_ESCAPE_TEST_CHAR_H is required")
endif()

file(WRITE "${APR_ESCAPE_TEST_CHAR_H}" "/* this file is automatically generated by CMake, do not edit. */\n")
file(APPEND "${APR_ESCAPE_TEST_CHAR_H}" "#define T_ESCAPE_SHELL_CMD     (0x01)\n")
file(APPEND "${APR_ESCAPE_TEST_CHAR_H}" "#define T_ESCAPE_PATH_SEGMENT  (0x02)\n")
file(APPEND "${APR_ESCAPE_TEST_CHAR_H}" "#define T_OS_ESCAPE_PATH       (0x04)\n")
file(APPEND "${APR_ESCAPE_TEST_CHAR_H}" "#define T_ESCAPE_ECHO          (0x08)\n")
file(APPEND "${APR_ESCAPE_TEST_CHAR_H}" "#define T_ESCAPE_URLENCODED    (0x10)\n")
file(APPEND "${APR_ESCAPE_TEST_CHAR_H}" "#define T_ESCAPE_XML           (0x20)\n")
file(APPEND "${APR_ESCAPE_TEST_CHAR_H}" "#define T_ESCAPE_LDAP_DN       (0x40)\n")
file(APPEND "${APR_ESCAPE_TEST_CHAR_H}" "#define T_ESCAPE_LDAP_FILTER   (0x80)\n\n")
file(APPEND "${APR_ESCAPE_TEST_CHAR_H}" "static const unsigned char test_char_table[256] = {")

foreach(c RANGE 0 255)
  set(flags 0)

  if(NOT c EQUAL 0)
    if(WIN32 OR OS2)
      if(c EQUAL 38 OR c EQUAL 59 OR c EQUAL 96 OR c EQUAL 39 OR c EQUAL 34 OR c EQUAL 124 OR c EQUAL 42 OR c EQUAL 63 OR c EQUAL 126 OR c EQUAL 60 OR c EQUAL 62 OR c EQUAL 94 OR c EQUAL 40 OR c EQUAL 41 OR c EQUAL 91 OR c EQUAL 93 OR c EQUAL 123 OR c EQUAL 125 OR c EQUAL 36 OR c EQUAL 92 OR c EQUAL 10 OR c EQUAL 13 OR c EQUAL 37)
        math(EXPR flags "${flags} | 0x01")
      endif()
    else()
      if(c EQUAL 38 OR c EQUAL 59 OR c EQUAL 96 OR c EQUAL 39 OR c EQUAL 34 OR c EQUAL 124 OR c EQUAL 42 OR c EQUAL 63 OR c EQUAL 126 OR c EQUAL 60 OR c EQUAL 62 OR c EQUAL 94 OR c EQUAL 40 OR c EQUAL 41 OR c EQUAL 91 OR c EQUAL 93 OR c EQUAL 123 OR c EQUAL 125 OR c EQUAL 36 OR c EQUAL 92 OR c EQUAL 10)
        math(EXPR flags "${flags} | 0x01")
      endif()
    endif()

    if(NOT (c EQUAL 36 OR c EQUAL 45 OR c EQUAL 95 OR c EQUAL 46 OR c EQUAL 43 OR c EQUAL 33 OR c EQUAL 42 OR c EQUAL 39 OR c EQUAL 40 OR c EQUAL 41 OR c EQUAL 44 OR c EQUAL 58 OR c EQUAL 64 OR c EQUAL 38 OR c EQUAL 61 OR c EQUAL 126 OR (c GREATER_EQUAL 48 AND c LESS_EQUAL 57) OR (c GREATER_EQUAL 65 AND c LESS_EQUAL 90) OR (c GREATER_EQUAL 97 AND c LESS_EQUAL 122)))
      math(EXPR flags "${flags} | 0x02")
    endif()

    if(NOT (c EQUAL 36 OR c EQUAL 45 OR c EQUAL 95 OR c EQUAL 46 OR c EQUAL 43 OR c EQUAL 33 OR c EQUAL 42 OR c EQUAL 39 OR c EQUAL 40 OR c EQUAL 41 OR c EQUAL 44 OR c EQUAL 58 OR c EQUAL 64 OR c EQUAL 38 OR c EQUAL 61 OR c EQUAL 47 OR c EQUAL 126 OR (c GREATER_EQUAL 48 AND c LESS_EQUAL 57) OR (c GREATER_EQUAL 65 AND c LESS_EQUAL 90) OR (c GREATER_EQUAL 97 AND c LESS_EQUAL 122)))
      math(EXPR flags "${flags} | 0x04")
    endif()

    if(NOT (c EQUAL 46 OR c EQUAL 45 OR c EQUAL 42 OR c EQUAL 95 OR c EQUAL 32 OR (c GREATER_EQUAL 48 AND c LESS_EQUAL 57) OR (c GREATER_EQUAL 65 AND c LESS_EQUAL 90) OR (c GREATER_EQUAL 97 AND c LESS_EQUAL 122)))
      math(EXPR flags "${flags} | 0x10")
    endif()

    if(c LESS 32 OR c GREATER 126 OR c EQUAL 34 OR c EQUAL 92)
      math(EXPR flags "${flags} | 0x08")
    endif()

    if(c LESS 32 OR c GREATER 126 OR c EQUAL 34 OR c EQUAL 43 OR c EQUAL 44 OR c EQUAL 59 OR c EQUAL 60 OR c EQUAL 62 OR c EQUAL 92)
      math(EXPR flags "${flags} | 0x40")
    endif()

    if(c LESS 32 OR c GREATER 126 OR c EQUAL 42 OR c EQUAL 40 OR c EQUAL 41 OR c EQUAL 92)
      math(EXPR flags "${flags} | 0x80")
    endif()

    if(c EQUAL 34 OR c EQUAL 38 OR c EQUAL 60 OR c EQUAL 62)
      math(EXPR flags "${flags} | 0x20")
    endif()
  endif()

  math(EXPR _mod "${c} % 20")
  if(c EQUAL 0 OR _mod EQUAL 0)
    file(APPEND "${APR_ESCAPE_TEST_CHAR_H}" "\n    ")
  else()
    file(APPEND "${APR_ESCAPE_TEST_CHAR_H}" " ")
  endif()

  file(APPEND "${APR_ESCAPE_TEST_CHAR_H}" "${flags}")
  if(c LESS 255)
    file(APPEND "${APR_ESCAPE_TEST_CHAR_H}" ",")
  else()
    file(APPEND "${APR_ESCAPE_TEST_CHAR_H}" " ")
  endif()
endforeach()

file(APPEND "${APR_ESCAPE_TEST_CHAR_H}" "\n};\n")
